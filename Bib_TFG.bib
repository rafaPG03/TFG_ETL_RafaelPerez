@misc{marcelo_business_2023,
	location = {Rochester, {NY}},
	title = {Business Intelligence: Development of a Dashboard for Big Data Analysis},
	url = {https://papers.ssrn.com/abstract=6758058},
	doi = {10.2139/ssrn.6758058},
	shorttitle = {Business Intelligence},
	abstract = {Business Intelligence ({BI}) is the process of collecting, analyzing and transforming data into useful information for decision-making in organizations. Information technology ({IT}) techniques and tools have evolved a lot in recent years, generating an absurd amount of data. One of the main challenges is dealing with the large volume, variety and speed of data generated today, known as Big Data. Big Data requires specific methods and platforms for its storage, processing and analysis. The dashboard is an important tool for {BI}, as it allows you to present data in a visual, interactive and dynamic way, facilitating the understanding and communication of results. In this work we developed an interactive dashboard using a database that provides information relating to more than one hundred years of the Olympic Games. The article was entirely authored without the use of generative artificial intelligence tools for content creation, writing, development, or textual structuring. All content presented reflects exclusively the author´s own research, analysis, interpretation, and intellectual production.},
	number = {6758058},
	publisher = {Social Science Research Network},
	author = {Marcelo},
	urldate = {2026-06-27},
	date = {2023-11-22},
	langid = {english},
